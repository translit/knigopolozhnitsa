{%- set _nm = {navigation: navigation, standalone: standalone, noSwipe: noSwipe, type: type} | navMode -%}
<!DOCTYPE html>
<html lang="cu" translate="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="google" content="notranslate">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ (navigation.title or title) | striptags }}</title>
    <link rel="stylesheet" href="/assets/css/style.css">
    <meta name="color-scheme" content="light dark">
    <!-- Ornament period flag: hides rotating ornaments before first paint on special days -->
    <script src="/assets/js/liturgical-period.js"></script>
    <script>
      (function () {
        var period = getPeriod(new Date());
        if (period !== 'ordinary') {
          document.documentElement.classList.add('orn-rotate');
          // Safety net: remove the class after 2s in case ornament-rotation.js fails to run.
          setTimeout(function () { document.documentElement.classList.remove('orn-rotate'); }, 2000);
        }
      }());
    </script>
    <!-- Favicon -->
    <link rel="icon" href="/assets/images/icon.svg?v=2" type="image/svg+xml">
    <link rel="icon" href="/assets/images/favicon.ico?v=2" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png?v=2">
    <meta name="theme-color" content="#fbf5ea" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
    {% if _nm == 'chapter' or _nm == 'toc' %}
    {% set chapterNav = collections.all | getChapterNavigation(navigation.key) %}
    {% if chapterNav and chapterNav.next %}
    <link rel="prefetch" href="{{ chapterNav.next.url }}">
    {% endif %}
    {% endif %}
</head>
{% from "_partials/breadcrumb.njk" import breadcrumb %}
<body class="{{ bodyClass }}">
    <main>
        <!-- Breadcrumbs -->
        {% if navigation.key and navigation.key != "library" %}
        <nav class="breadcrumb" aria-label="Breadcrumb">
            {{ breadcrumb(collections, navigation.key) }}
        </nav>
        {% endif %}

        {% block content %}{% endblock %}

        <!-- Bottom Navigation -->
        {% if _nm != 'none' %}

        {% if _nm == 'standalone' %}
        <nav class="toc-navigation" aria-label="Navigation">
            <nav class="nav-breadcrumb" aria-label="Navigation Breadcrumb">
                {{ breadcrumb(collections, navigation.key) }}
            </nav>
        </nav>

        {% elif _nm == 'chapter' %}
        {% set chapterNav = collections.all | getChapterNavigation(navigation.key) %}
        {% if chapterNav %}
        <nav class="chapter-navigation" aria-label="Chapter Navigation">
            <nav class="nav-breadcrumb" aria-label="Navigation Breadcrumb">
                {{ breadcrumb(collections, navigation.key) }}
            </nav>
            <div class="nav-grid">
                {% if chapterNav.previous %}
                <a href="{{ chapterNav.previous.url }}" class="nav-button nav-prev" rel="prev" aria-label="Go to previous chapter">
                    ‹
                </a>
                {% else %}
                <div class="nav-button nav-disabled">
                    ‹
                </div>
                {% endif %}
                {% if chapterNav.next %}
                <a href="{{ chapterNav.next.url }}" class="nav-button nav-next" rel="next" aria-label="Go to next chapter">
                    ›
                </a>
                {% else %}
                <div class="nav-button nav-disabled">
                    ›
                </div>
                {% endif %}
            </div>
        </nav>
        {% endif %}

        {% elif _nm == 'toc' %}
        <nav class="toc-navigation" aria-label="TOC Navigation">
            <nav class="nav-breadcrumb" aria-label="Navigation Breadcrumb">
                {{ breadcrumb(collections, navigation.key) }}
            </nav>
        </nav>
        {% endif %}

        {% endif %}
    </main>

    <!-- JavaScript for navigation -->
    <script src="/assets/js/navigation.js"></script>
    <script src="/assets/js/ornament-rotation.js"></script>
</body>
</html>
