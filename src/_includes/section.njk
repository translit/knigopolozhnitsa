{% extends "_base.njk" %}
{% from "_partials/title.njk" import title as renderTitle %}
{% from "_partials/julian-date.njk" import julianDate, julianDateScript %}

{% set bodyClass = bodyClass or "section" %}

{% block content %}
{% set _orn = ornament %}
{% if _orn %}{% ornament _orn %}{% endif %}
{{ renderTitle(title) }}

{{ julianDate(show=showJulianDate, tone=showTone) }}

<nav class="section-nav">
    {{ content | safe }}
</nav>

{{ julianDateScript(show=showJulianDate, tone=showTone) }}
{% endblock %}
