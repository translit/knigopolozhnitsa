---
title: '<span class="display">Ѻ҆ктѡ́ихъ,</span><br>си́рѣчь ѻ҆смогла́сникъ.'
layout: work.njk
ornament: headpiece-l2
glasFolds:
  - label: "Гла́съ а҃"
    start: 1
    end: 7
  - label: "Гла́съ в҃"
    start: 8
    end: 14
  - label: "Гла́съ г҃"
    start: 15
    end: 21
  - label: "Гла́съ д҃"
    start: 22
    end: 28
  - label: "Гла́съ є҃"
    start: 29
    end: 35
  - label: "Гла́съ ѕ҃"
    start: 36
    end: 42
  - label: "Гла́съ з҃"
    start: 43
    end: 49
  - label: "Гла́съ и҃"
    start: 50
    end: 56
tocDividers:
  - "56"
navigation:
  key: service-octoechos
  title: "Ѻ҆ктѡ́ихъ"
  parent: service
---

{% set unsortedParts = [] %}
{% for part in collections.serviceParts %}
  {% if part.inputPath.includes('/service/octoechos/') %}
    {% set unsortedParts = (unsortedParts.push(part), unsortedParts) %}
  {% endif %}
{% endfor %}

{% set sortedParts = unsortedParts | sortByNumber %}

<ul class="work-toc">
{% for glas in glasFolds %}
  <details>
    <summary><span class="triangle">▶</span><span class="summary-toc">{{ glas.label }}</span></summary>
    <ul>
    {% for part in sortedParts %}
      {% set num = part.fileSlug | int %}
      {% if num >= glas.start and num <= glas.end %}
      <li><a href="{{ part.fileSlug }}/">{{ part.data.navigation.title or (part.data.title | safe) }}</a></li>
      {% endif %}
    {% endfor %}
    </ul>
  </details>
{% endfor %}
<li class="toc-divider" aria-hidden="true"></li>
{% for part in sortedParts %}
  {% set num = part.fileSlug | int %}
  {% if num > (tocDividers[0] | int) %}
  <li><a href="{{ part.fileSlug }}/">{{ part.data.navigation.title or (part.data.title | safe) }}</a></li>
  {% endif %}
{% endfor %}
</ul>
